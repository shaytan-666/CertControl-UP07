<Page x:Class="CertControl.Pages.AddEditCertificatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      
      Title="Сертификат">

    <ScrollViewer>

        <StackPanel
            Width="500"
            Margin="30">

            <TextBlock
                Text="Карточка сертификата"
                FontSize="26"
                FontWeight="Bold"
                Margin="0,0,0,20"/>

            <TextBlock Text="Номер"/>

            <TextBox
                Text="{Binding serial_number}"
                Margin="0,5,0,15"/>

            <TextBlock Text="Название"/>

            <TextBox
                Text="{Binding name}"
                Margin="0,5,0,15"/>

            <TextBlock Text="Дата выдачи"/>

            <DatePicker
                SelectedDate="{Binding issue_date}"
                Margin="0,5,0,15"/>

            <TextBlock Text="Дата окончания"/>

            <DatePicker
                SelectedDate="{Binding end_date}"
                Margin="0,5,0,15"/>

            <TextBlock Text="Владелец"/>

            <ComboBox
    x:Name="OwnerComboBox"
    DisplayMemberPath="full_name"
    SelectedValuePath="id"
    SelectedValue="{Binding owner_id}"
    Margin="0,5,0,15"/>

            <TextBlock Text="Тип сертификата"/>

            <ComboBox
    x:Name="TypeComboBox"
    DisplayMemberPath="type"
    SelectedValuePath="id"
    SelectedValue="{Binding certificate_type_id}"
    Margin="0,5,0,15"/>
            <TextBlock Text="Статус сертификата"/>

            <ComboBox
    x:Name="StatusComboBox"
    DisplayMemberPath="status"
    SelectedValuePath="id"
    SelectedValue="{Binding certificate_status_id}"
    Margin="0,5,0,15"/>

            <TextBlock Text="Центр сертификации"/>

            <ComboBox
    x:Name="AuthorityComboBox"
    DisplayMemberPath="name"
    SelectedValuePath="id"
    SelectedValue="{Binding certificate_authority_id}"
    Margin="0,5,0,15"/>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <Button
                    Content="Сохранить"
                    Width="120"
                    Margin="5"
                    Click="SaveButton_Click"/>

                <Button
                    Content="Назад"
                    Width="120"
                    Margin="5"
                    Click="BackButton_Click"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</Page>

