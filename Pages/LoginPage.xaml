<Page x:Class="CertControl.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <StackPanel
            Width="320"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <TextBlock
                Text="CertControl"
                FontSize="30"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,25"/>

            <TextBlock Text="Логин"/>

            <TextBox
                x:Name="LoginTextBox"
                Height="35"
                Margin="0,5,0,15"/>

            <TextBlock Text="Пароль"/>

            <PasswordBox
                x:Name="PasswordBox"
                Height="35"
                Margin="0,5,0,20"/>

            <Button
                Content="Войти"
                Height="40"
                Click="LoginButton_Click"/>

        </StackPanel>

    </Grid>

</Page>

